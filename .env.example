# Templar Liquidator Configuration

# ============================================
# REQUIRED
# ============================================

SIGNER_ACCOUNT_ID=your-account.near
SIGNER_KEY=ed25519:YOUR_PRIVATE_KEY_HERE
REGISTRY_ACCOUNT_IDS=v1.tmplr.near

# ============================================
# NETWORK
# ============================================

NEAR_NETWORK=mainnet
NEAR_RPC_URL=https://rpc.mainnet.fastnear.com

# RPC API key (e.g. a FastNEAR key), sent as an Authorization header to
# NEAR_RPC_URL. One variable, read by the binary directly and exported by the
# run scripts — the same name works for `cargo run`, the container, and a
# scheduled cloud job.
#
# It has to reach an endpoint that accepts one. NEAR_RPC_URL above names the
# keyed host for that reason: pointed at the keyless free.rpc.fastnear.com
# tier, setting this key changes nothing and the rate limiting below is what
# you get anyway.
#
# Without it, a full-registry scan gets rate-limited part-way through — and
# the bot then reports a clean cycle over whatever it could read, so the
# failure is silent.
# NEAR_RPC_API_KEY=your_api_key_here

# NEAR_API_KEY was the old spelling, folded into the URL as `?apiKey=` back
# when the bot had no header support. The run scripts still accept it and map
# it onto NEAR_RPC_API_KEY with a deprecation notice; nothing else reads it.
# NEAR_API_KEY=your_api_key_here

# ============================================
# LIQUIDATION STRATEGY
# ============================================

# Liquidation strategies (mutually exclusive - choose ONE):
# 1. Percentage-based (default if neither is set):
#    - Set PARTIAL_LIQUIDATION_PERCENTAGE (1-100)
#    - Uses percentage of available liquidatable collateral per liquidation
#    - If not set, defaults to 100% (liquidate maximum allowed)
#    - Example: 50 = use 50% of available liquidatable collateral
# 2. Fixed amount:
#    - Set FIXED_LIQUIDATION_AMOUNT_USD
#    - Uses a fixed USD amount per liquidation iteration
#    - Works across all USD-based markets (USDC, USDT, DAI, Stellar USDC via OMNI, etc.)
#    - Example: 100 = liquidate $100 USD worth per iteration

# Percentage of available liquidatable collateral (1-100)
# Mutually exclusive with FIXED_LIQUIDATION_AMOUNT_USD
# If both not set, defaults to 100%
# Example: 50 = use 50% of available liquidatable collateral per liquidation
# PARTIAL_LIQUIDATION_PERCENTAGE=50

# Fixed liquidation amount in USD
# Mutually exclusive with PARTIAL_LIQUIDATION_PERCENTAGE
# Works across all USD-based markets regardless of decimals
# The liquidator automatically converts to the correct raw units based on each market's asset decimals
# Example: 100 = liquidate $100 USD worth per iteration
# FIXED_LIQUIDATION_AMOUNT_USD=100

# Enable loop liquidation - repeatedly liquidate until position is healthy
# When true and a position remains liquidatable after one liquidation, will continue
# liquidating in a loop until position becomes healthy or runs out of funds
# Default: false
LOOP_LIQUIDATION=false

# Maximum iterations for loop liquidation (safety limit to prevent infinite loops)
# Only applies when LOOP_LIQUIDATION=true
# Default: 10
MAX_LOOP_ITERATIONS=10

# Minimum profit margin in basis points
# Examples: 50 = 0.5%, 100 = 1%, 200 = 2%
# Default: 50 (0.5%)
MIN_PROFIT_BPS=50

# ============================================
# COLLATERAL STRATEGY
# ============================================

# Collateral strategy: "hold" or "swap-to-borrow"
# - hold: Keep all received collateral (no swaps)
# - swap-to-borrow: Swap collateral back to borrow assets (assets used for liquidations)
# Default: hold
COLLATERAL_STRATEGY=hold

# ============================================
# SWAP PROVIDER CONFIGURATION 
# ============================================

# 1-Click API token (optional but recommended to avoid 0.1% fee)
# ONECLICK_API_TOKEN=your_jwt_token_here

# Minimum USD value to attempt a swap (JIT or batch)
# Amounts below this threshold are skipped and left for the next batch swap cycle
# Default: 10.0
MIN_SWAP_VALUE_USD=10.0

# Enable batch swap of accumulated collateral at the start of each liquidation round
# When true, swaps all collateral holdings above MIN_SWAP_VALUE_USD before scanning for liquidations
# Default: true
BATCH_SWAP_ON_CYCLE_START=true

# Maximum retry attempts for transient swap errors (includes first attempt)
# Default: 3
SWAP_RETRY_ATTEMPTS=3

# Base delay in milliseconds for swap retry exponential backoff (2s, 4s, 8s …)
# Default: 2000
SWAP_RETRY_BASE_DELAY_MS=2000

# ============================================
# INTERVALS
# ============================================

# Liquidation scan interval (seconds)
# How often to scan markets for liquidation opportunities
# Default: 600 (10 minutes)
LIQUIDATION_SCAN_INTERVAL=600

# Registry refresh interval (seconds)
# How often to check for new markets
# Default: 3600 (1 hour)
REGISTRY_REFRESH_INTERVAL=3600

# Execution mode: loop (default, continuous) | once (single cycle then exit — for cron/Cloud Run Jobs)
RUN_MODE=loop

# ============================================
# OPTIONAL
# ============================================

# Concurrency for registry deployment listing (NOT liquidations — see
# POSITION_CONCURRENCY below for that)
# Default: 10
CONCURRENCY=10

# Positions evaluated/liquidated concurrently within one market's round.
# 1 (the default) is fully sequential with a 1-second pause between positions —
# what free public RPC endpoints tolerate. Raising it drops the pause and fans
# evaluation out; bring an RPC endpoint sized for the load. This is the
# throughput lever for liquidations.
# Default: 1
# POSITION_CONCURRENCY=1

# Optional /healthz + /metrics endpoint (Prometheus text format). Unset = disabled.
# Ignored in RUN_MODE=once and push-check (a single-cycle run exits before it could be scraped).
# The endpoints are unauthenticated, so the listener binds loopback by default
# (HTTP_BIND_ADDR) and the shipped Compose files publish the port to 127.0.0.1 on
# the host. Serving it to another machine is a deliberate opt-in — note Docker's
# published-port rules are evaluated before UFW, so a firewall rule does not
# protect a published port. /healthz is a readiness signal (can the bot currently
# reach the chain?), not a liveness one: don't wire it to a restart-on-failure
# probe, since restarting a process stuck because RPC is down doesn't fix RPC.
# HTTP_PORT=9090
# HTTP_BIND_ADDR=127.0.0.1
# Inside a container this must be 0.0.0.0 — Docker publishes a port by DNAT to
# the container's own IP, so a listener on the container's loopback is
# unreachable through the mapping. The shipped Compose files set it for you and
# keep the exposure control on the host side (`127.0.0.1:9090:9090`).

# ============================================
# MARKET FILTERING
# ============================================

# Allowed collateral assets (comma-separated)
# If specified, ONLY markets with these collateral assets will be processed
# If empty, all assets are allowed (unless in ignored list)
# Examples:
#   - NEP-141: nep141:btc.omft.near
#   - NEP-245: nep245:intents.near:nep141:btc.omft.near
#ALLOWED_COLLATERAL_ASSETS=nep141:btc.omft.near,nep141:wrap.near

# Ignored collateral assets (comma-separated)
# Markets with these collateral assets will be filtered out
# Examples:
#   - Ignore stNEAR: nep141:meta-pool.near
#   - Ignore LINEAR: nep141:linear-protocol.near
#IGNORED_COLLATERAL_ASSETS=nep141:meta-pool.near

# Allowed markets (comma-separated account IDs)
# When set, ONLY these markets are processed; IGNORED_MARKETS still
# subtracts within the allowlist. An unparseable entry refuses startup
# (a silently dropped entry could empty the allowlist and fail open).
# ALLOWED_MARKETS=ibtc-usdc.v1.tmplr.near

# Ignored markets (comma-separated account IDs)
# These specific markets will be skipped entirely
# IGNORED_MARKETS=liqtest-market.v1.tmplr.near

# ============================================
# TESTING & DEBUGGING
# ============================================

# Dry run mode - scan and log without executing
# When true, scans for liquidations and logs what WOULD happen, but never
# submits transactions. This is the default and the safe choice for first
# runs: verify strategy, allowlists, and keys before going live.
# Set to false to submit real transactions on-chain and actually liquidate
# positions. This moves real funds — only disable once you trust the setup.
# Accepts ONLY the literal values `true` or `false` (case-sensitive) — `1`,
# `0`, `False`, `no`, a blank `DRY_RUN=`, or a quoted `"false"` all fail to
# parse and the process refuses to start. Fail-closed is intentional, but
# every live deployment must now set this var explicitly: a stray blank or
# malformed value here is a crash loop, not a silent fallback.
# Default: true
DRY_RUN=true

# Logging
RUST_LOG=info
# one JSON object per line, for log aggregators
# LOG_FORMAT=json

# ============================================
# ORACLE PRICE SOURCES
# ============================================

# RedStone public price API, used to compose proxy-oracle prices off-chain at
# scan time (no gas, no keeper dependency). Scan-side only — execution still
# prices through the on-chain oracle.
# Default: https://api.redstone.finance
# REDSTONE_API_URL=https://api.redstone.finance
# RedStone push leg: before a liquidation, RedStone-signed packages are
# pushed to the RedStone adapter for the feeds the Pyth Pro push cannot
# refresh — those without a Pyth Pro source, and every feed when no
# LAZER_API_TOKEN is set. Nothing else keeps those adapters fresh.
# Packages are fetched from RedStone's public gateway (no key) and verified
# locally against the adapter's on-chain signer set before any gas is
# spent. Defaults shown; REDSTONE_PUSH=false disables the leg.
# REDSTONE_GATEWAY_URL=https://oracle-gateway-1.a.redstone.finance
# REDSTONE_DATA_SERVICE_ID=redstone-primary-prod
# REDSTONE_PUSH=true

# Pyth Pro API for scan-side pricing of Pyth Pro–sourced proxy feeds —
# fresh prices with no dependence on anyone pushing on-chain state, and the
# ONLY Pyth Pro scan leg (no on-chain adapter read: stale, or a paid push).
# Token-gated (no anonymous tier): the Pyth API key from Pyth Terminal
# (pythdata.app) — the same key Hermes requires now. Without a
# token, Pyth Pro–sourced markets are filtered at registration.
# With a token set, LAZER_API_URL must be https — the bot refuses to start
# rather than send the token in cleartext.
# LAZER_API_URL=https://pyth-lazer.dourolabs.app
# LAZER_API_TOKEN=your-pyth-pro-access-token
# Pyth Pro websocket stream for the on-chain price push before a live
# liquidation (same token). Must be wss://. Default shown.
# LAZER_WS_URL=wss://pyth-lazer-0.dourolabs.app/v1/stream

# ============================================
# TELEGRAM NOTIFICATIONS
# ============================================

# Telegram bot token for sending notifications
# Create a bot via @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Telegram chat ID to send notifications to
# Use @userinfobot or @RawDataBot to get your chat ID
# TELEGRAM_CHAT_ID=-100123456789

# Optional: Telegram thread/topic ID for sending to a specific topic in a group
# TELEGRAM_THREAD_ID=42

# Number of consecutive scan failures per market before sending a Telegram alert.
# A recovery notification is also sent when the market starts working again.
# Set to 0 to disable scan failure notifications.
# Default: 2
# SCAN_FAILURE_NOTIFY_THRESHOLD=2

# Cooldown in hours for repeated "Liquidation Failed" notifications with the
# same (market, borrower, error class). A successful liquidation for that
# borrower resets the cooldown immediately so the next failure (of any kind)
# fires a fresh alert.
# Default: 24
# FAILURE_NOTIFICATION_COOLDOWN_HOURS=24
